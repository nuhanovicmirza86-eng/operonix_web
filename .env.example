# PRODUKCIJA: bar jedan kanal ispod. Red u kodu: Resend → Web3Forms → Firebase ingest.
#
# Upitnik / assessment — slanje e-maila
# (Vercel) Najčešće: Resend ispod — ne ostavljajte pogrešne OPERONIX_* u env jer su ranije imali prednost.
#
# Firebase (zapis u Firestore + e-mail na funkciji): puni URL + tajna
OPERONIX_QUOTE_FUNCTION_URL=
OPERONIX_QUOTE_INGEST_SECRET=

# Web3Forms: https://web3forms.com — Access Key, bez kartice, na vaš e-mail
WEB3FORMS_ACCESS_KEY=

# Ili Resend: https://resend.com
RESEND_API_KEY=
# Primatelji upitnika (zarez ili tačka-zarez). Isti par je zadan u kodu ako ovo ostavite prazno.
# Ime mora biti točno ASSESSMENT_TO_EMAIL (dva „s“: AsSEssment). Pogrešno ASSESMENT_TO_EMAIL takođe se čita kao rezerva.
ASSESSMENT_TO_EMAIL=info@operonixindustrial.com,nuhanovic.mirza86@gmail.com
# Pošiljalac za Resend: bilo koja adresa @ DOMENE KOJU STE DODALI U RESEND (ne mora biti stvarni inbox).
# Tipično: info@, noreply@, hello@ — zamijenite svojom domenom i adresom koju Resend prihvati.
RESEND_FROM=Operonix <info@operonixindustrial.com>
